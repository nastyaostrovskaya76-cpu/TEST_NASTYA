# Скопируйте этот файл в .env.local и вставьте значения (на Vercel — Settings → Environment Variables)

# Адрес проекта Supabase: Project Settings → Data API → Project URL (вида https://xxxx.supabase.co)
SUPABASE_URL=
# Секретный ключ Supabase: Project Settings → API Keys → Secret keys (начинается с sb_secret_). Никому не показывать
SUPABASE_SECRET_KEY=
# Токен бота от @BotFather (длинная строка с двоеточием)
TELEGRAM_BOT_TOKEN=
# Числовой id вашего чата с ботом: напишите боту, затем npm run telegram:chat-id (или узнайте у @userinfobot)
TELEGRAM_CHAT_ID=
# Адрес сайта после публикации, например https://ostrovskaya.by (на Vercel можно не указывать до подключения домена)
SITE_URL=
